{
  "name": "iam-access-key-rotation",
  "version": "0.1.0",
  "bin": {
    "iam-access-key-rotation": "bin/iam-access-key-rotation.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean:lambda": "find lambda -name '*.js' -not -path '*/node_modules/*' -delete && find lambda -name '*.d.ts' -not -path '*/node_modules/*' -delete",
    "pretest": "npm run clean:lambda",
    "test": "jest --silent",
    "cdk": "npm run pretest && npm run build && npm run test && npx cdk synth && npx cdk deploy",
    "destroy": "npx cdk destroy"
  },
  "devDependencies": {
    "@aws-sdk/client-iam": "^3.987.0",
    "@aws-sdk/client-secrets-manager": "^3.987.0",
    "@aws-sdk/client-ses": "^3.987.0",
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1104.0",
    "esbuild": "^0.27.3",
    "jest": "^30",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.236.0",
    "constructs": "^10.0.0"
  }
}